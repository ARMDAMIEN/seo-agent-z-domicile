# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7

# Google OAuth2 (Desktop-type OAuth 2.0 Client from GCP console)
# Same client works for any Google API — scopes are granted at token-generation time.
# Org policies that block service-account KEYS do NOT affect OAuth clients; this setup works with iam.disableServiceAccountKeyCreation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Search Console
GSC_SITE_URL=https://www.z-domicile.fr/
# Run `npm run gsc:token` once to obtain this (requires webmasters.readonly scope)
GSC_REFRESH_TOKEN=

# GitHub (fine-grained PAT with `contents:write` on the frontend repo — direct-commit)
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main

# Agent tuning
MAX_TASKS_PER_RUN=3               # Execute at most N tasks from the queue per weekly run
RECENT_DONE_COOLDOWN_DAYS=14      # Don't re-task the same dedup_key if it was marked done within N days (GSC re-crawl lag protection)

# Telegram (final run summary)
TELEGRAM_BOT_API_KEY=
TELEGRAM_CHAT_ID=
